# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Guild (server) IDs. Enable Developer Mode in Discord, then right-click a
# server icon -> "Copy Server ID".
SOURCE_GUILD_ID=
DEST_GUILD_ID=

# Prefix for text commands (e.g. !backfill). Optional, defaults to "!".
COMMAND_PREFIX=!

# Off by default. With this unset/false, the bot only relays history when
# you explicitly run !backfill. Run !livesync to backfill and enable live
# relaying until restart, or set this to true to have live relaying enabled
# whenever the bot starts. New source emojis are cloned live regardless.
ENABLE_LIVE_RELAY=false
