# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Guild (server) IDs. Enable Developer Mode in Discord, then right-click a
# server icon -> "Copy Server ID".
SOURCE_GUILD_ID=
DEST_GUILD_ID=

# Prefix for text commands (e.g. !backfill). Optional, defaults to "!".
COMMAND_PREFIX=!

# Off by default. With this unset/false, the bot never relays new messages,
# edits, or reactions live -- it only sends anything when you explicitly
# run !backfill (and it still clones new source emojis live regardless,
# since that's a separate opt-in). Set to true to also relay live.
ENABLE_LIVE_RELAY=false
